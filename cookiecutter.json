{
  "_skpkg_schema_version": "0.0.1",
  "authors": "Simon Billinge <sbillinge@ucsb.edu>; Sangjoon Lee <bobleesj@stanford.edu>",
  "__validate_authors": "{% if cookiecutter.authors is defined %}{{ cookiecutter.authors | validate_contact_pair('authors') }}{% endif %}",
  "maintainers": "{{ cookiecutter.authors }}",
  "__validate_maintainers": "{% if cookiecutter.maintainers is defined %}{{ cookiecutter.maintainers | validate_contact_pair('maintainers') }}{% endif %}",
  "authorized_maintainer_github_username": "sbillinge",
  "__validate_authorized_maintainer_github_username": "{% if cookiecutter.authorized_maintainer_github_username is defined %}{{ cookiecutter.authorized_maintainer_github_username | validate_single_github_username }}{% endif %}",
  "project_name": "diffpy.my-project",
  "__prompts__": {
    "contributors": "contributors, comma-separated (\"and contributors to the project\" is added automatically)"
  },
  "contributors": "{{ (cookiecutter.authors | split_contacts)[0] | join(', ') }}",
  "__contributors_str": "{{ (cookiecutter.contributors ~ ', contributors to the project') | list_in_str }}",
  "license_holders": "Contributors to the {{ cookiecutter.project_name }} project",
  "github_username_or_orgname": "diffpy",
  "github_repo_name": "{{ cookiecutter.project_name|replace(' ', '-')|lower }}",
  "conda_pypi_package_dist_name": "{{ cookiecutter.project_name|replace(' ', '-')|lower }}",
  "package_dir_name": "{{ cookiecutter.project_name|replace(' ', '_')|replace('-', '_')|lower }}",
  "project_short_description": "Python package for doing science.",
  "project_keywords": "diffraction, PDF, X-ray, neutron",
  "minimum_supported_python_version": "3.12",
  "maximum_supported_python_version": "3.14",
  "project_needs_c_code_compiled": ["No", "Yes"],
  "project_has_gui_tests": ["No", "Yes"],
  "_is_skpkg_update": "No",
  "_copy_without_render": ["*.html", "*.js", ".github/*"],
  "_extensions": ["hooks.local_extensions.people_contact_info_Extension"]
}
